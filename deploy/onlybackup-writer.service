[Unit]
Description=OnlyBackup isolated upload writer
Requires=onlybackup-vault.service
After=local-fs.target onlybackup-vault.service

[Service]
Type=simple
User=onlybackup-writer
Group=onlybackup-ingest
SupplementaryGroups=onlybackup-vault-ingest
UMask=0077
RuntimeDirectory=onlybackup
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/onlybackup-writer --socket /run/onlybackup/writer.sock --vault-socket /run/onlybackup-vault/vault.sock
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
InaccessiblePaths=/var/lib/onlybackup
ReadWritePaths=/run/onlybackup
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
