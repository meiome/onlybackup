[Unit]
Description=OnlyBackup protected archive custodian
After=local-fs.target

[Service]
Type=simple
User=onlybackup-vault
Group=onlybackup-vault-ingest
UMask=0077
RuntimeDirectory=onlybackup-vault
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/onlybackup-vault --state /var/lib/onlybackup --socket /run/onlybackup-vault/vault.sock --reserve-free 1GiB
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
ReadWritePaths=/var/lib/onlybackup /run/onlybackup-vault
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
